#!/bin/bash

list_editors_for_dmenu() {
    local editors=("neovim" "vim" "nano" "micro" "helix" "emacs" "kak" "vis")
    local found_editors=()

    for e in "${editors[@]}"; do
        if which "$e" >/dev/null 2>&1; then
            found_editors+=("$e")
        fi
    done

    printf "%s\n" "${found_editors[@]}"
}

case $1 in 
    "-p"|"--prompt")
        chosen=$(list_editors_for_dmenu | gum choose --header="  Set default terminal editor")
        [ -z "$chosen" ] && exit 1
        ;;
    *)
        chosen=$(list_editors_for_dmenu | rofi -config $HOME/.config/mango/rofi/themes/browser.rasi -show drun -dmenu -i -p " ")
        [ -z "$chosen" ] && exit 1
        ;;
esac

ZSHRC="$HOME/.zshrc"

sed -i -E "s|^([[:space:]]*export[[:space:]]+EDITOR=)['\"][^'\"]+['\"]|\1'$chosen'|" "$ZSHRC"

notify-send "Default terminal editor set to $chosen"

