{

  "backlight": {
    "interval": 2,
    "device": "amdgpu_bl0",
    "format": "{icon}",
    "format-icons": [
      "󰖔 ",
      "󰖨 "
    ],
    "on-click": "bash -c '$HOME/.config/mango/scripts/Sunset.sh'",
    "on-scroll-up": "$HOME/.config/mango/scripts/Brightness.sh --inc",
    "on-scroll-down": "$HOME/.config/mango/scripts/Brightness.sh --dec",
    "smooth-scrolling-threshold": 1
  },

  "cpu": {
    "format": "󰍛 {usage}% ",
    "interval": 1,
    "min-length": 5,
    "format-alt-click": "click",
    "format-alt": "{icon0}{icon1}{icon2}{icon3} {usage:>2}% 󰍛",
    "format-icons": [
      "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"
    ],
    "on-click-right": "xdg-terminal-exec btop"
  },


  "memory": {
    "interval": 10,
    "format": "{used:0.1f}G󰾆 ",
    "format-alt": "{percentage}%󰾆 ",
    "format-alt-click": "click",
    "tooltip": true,
    "tooltip-format": "{used:0.1f}GB/{total:0.1f}G",
    "on-click-right": "xdg-terminal-exec btop"
  },

  "temperature": {
    "critical-threshold": 90,
    "format": "{icon}{temperatureC}°C",
    "tooltip": true,
    "format-icons": ["󰈸"]
  },

  "clock": {
    "format": "{:%H:%M} ",
    "format-alt": "{  %d·%m·%y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#ff6699'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "weekdays": "<span color='#7CD37C'><b>{}</b></span>",
        "today": "<span color='#ffcc66'><b>{}</b></span>"
      }
    }
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    //"on-click": "foot --app-id=wifi-term -e bash ~/.config/mango/scripts/wifi-gum.sh"
    "on-click": "foot --app-id=wifi-term -e bash gazelle"
  },

    "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "foot --app-id=blue-term -e bluetui"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon} 󰂰 {volume}",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        "󰕾",
        ""
      ],
      "ignored-sinks": [
        "Easy Effects Sink"
      ]
    },
    "scroll-step": 5.0,
    "on-click": "$HOME/.config/mango/scripts/Volume.sh --toggle",
    //"on-click-right": "pavucontrol -t 3",
    "on-click-right": "foot --app-id=wifi-term wiremix",
    "on-scroll-up": "$HOME/.config/mango/scripts/Volume.sh --inc",
    "on-scroll-down": "$HOME/.config/mango/scripts/Volume.sh --dec",
    "tooltip-format": "{icon} {desc} | {volume}%",
    "smooth-scrolling-threshold": 1
  },
  
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "on-click": "$HOME/.config/mango/scripts/Volume.sh --toggle-mic",
    //"on-click-right": "pavucontrol -t 4",
    "on-click-right": "foot --app-id=wifi-term wiremix",
    //"on-click-right": "foot --app-id=wifi-term -e bash wiremix",
    "on-scroll-up": "$HOME/.config/mango/scripts/Volume.sh --mic-inc",
    "on-scroll-down": "$HOME/.config/mango/scripts/Volume.sh --mic-dec",
    "tooltip-format": "{icon} {desc} | {volume}%",
    "scroll-step": 5
  },


 "tray": {
    "icon-size": 12,
    "spacing": 17
  },

  "keyboard-state": {
    "capslock": true,
    "format": {
      "numlock": "N {icon}",
      "capslock": "󰪛 {icon}",
      },
      "format-icons": {
        "locked": "",
        "unlocked": ""
        },
    },

  "mpd": {
    "tooltip": true,
    "tooltip-format": "{artist} - {album} - {title} - Total Time : {totalTime:%M:%S}",
    "format": " {elapsedTime:%M:%S}",
    "format-disconnected": "⚠  Disconnected",
    "format-stopped": " Not Playing",
    "on-click": "mpc toggle",
    "state-icons": {
      "playing": "",
      "paused": ""
    }
  },
  "mpd#2": {
    "format": "",
    "format-disconnected": "",
    "format-paused": "",
    "format-stopped": "",
    // Commands to execute on events
    "on-click": "mpc -q pause && mpc -q prev && mpc -q start"
  },
  "mpd#3": {
    "interval": 1,
    "format": "{stateIcon}",
    "format-disconnected": "",
    "format-paused": "{stateIcon}",
    "format-stopped": "",
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    // Commands to execute on events
    "on-click": "mpc toggle"
  },
  "mpd#4": {
    "format": "",
    "format-disconnected": "",
    "format-paused": "",
    "format-stopped": "",
    // Commands to execute on events
    "on-click": "mpc -q pause && mpc -q next && mpc -q start"
  },

}
